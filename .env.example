# CORE — the application database. Never points at GEO.
DATABASE_URL=postgresql://markyra_app:CHANGEME@localhost:5432/markyra_core
# GEO — OSM-derived boundaries. Used ONLY by the offline pipeline, never the app.
GEO_DATABASE_URL=postgresql://markyra_geo_ro:CHANGEME@localhost:5432/markyra_geo
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Basemap archive. Unset = the map renders its designed degraded state.
# NEXT_PUBLIC_PMTILES_URL=https://cdn.example/basemap/markyra-basemap-YYYYMMDD.pmtiles

# Ops staff are provisioned by invitation only; there is no self-registration.
# Create the first one with: npm run ops:create-staff (see README)
SMS_PROVIDER=dev              # 'production' requires a configured TN gateway
NODE_ENV=development
