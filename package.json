{
  "name": "markyra",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:constitutional": "vitest run test/constitutional",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:reset": "node --experimental-strip-types scripts/reset.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run web:build && npm run ops:build",
    "api": "node --experimental-strip-types apps/api/server.ts",
    "db:seed": "node --experimental-strip-types scripts/seed-dev.ts",
    "db:unseed": "node --experimental-strip-types -e \"import('./platform/db.ts').then(async m=>{await m.getPool().query(\\\"delete from business where source_code='FIXTURE'\\\");await m.closePool();console.log('fixtures removed')})\"",
    "web": "next dev apps/web -p 3000",
    "web:build": "next build apps/web",
    "worker": "node --experimental-strip-types apps/worker/index.ts",
    "ops": "next dev apps/ops -p 3001",
    "dev:db": "./scripts/dev-db.sh",
    "ops:create-staff": "node --experimental-strip-types scripts/create-staff.ts",
    "ops:build": "next build apps/ops",
    "pilot:window0": "node --experimental-strip-types scripts/window0.ts",
    "pilot:gate": "node --experimental-strip-types scripts/pilot-gate.ts",
    "legal:docs": "node --experimental-strip-types scripts/gen-legal-docs.ts",
    "dev": "next dev apps/web -p 3000",
    "dev:full": "concurrently -n api,web -c blue,green \"npm:api\" \"npm:web\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.1",
    "maplibre-gl": "^6.6.0",
    "next": "^15.5.24",
    "pg": "^8.13.1",
    "pg-boss": "^12.28.1",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuidv7": "^1.0.2",
    "zod": "^3.23.8"
  }
}